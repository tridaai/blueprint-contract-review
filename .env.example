# Copy to .env and fill in. Every value is optional for the offline
# demo; the production topology (docker compose) sets DATABASE_URL and
# S3_* for you.

# --- Model backend -------------------------------------------------------
# mock (default) = deterministic offline fallback, clearly labelled.
# openai | anthropic | ollama = real provider calls.
MODEL_BACKEND=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# NVIDIA NIM — the endpoints NVIDIA's own blueprints deploy on:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b
# OPENAI_API_KEY=nvapi-...
# (model name verified live against the hosted catalog 2026-10-10;
# hosted catalog names rotate — if a name returns 410/404, pick its
# successor on build.nvidia.com. Or a self-hosted NIM container at
# http://localhost:8000/v1)

# --- System of record: PostgreSQL ---------------------------------------
# Records (decisions store), LangGraph checkpoints, and pgvector
# embeddings all live here. When unset, the app runs with in-memory
# doubles — tests and offline demos only, never a deployment story.
# DATABASE_URL=postgresql://contract:contract@localhost:5432/contracts

# --- Document storage: S3-compatible ------------------------------------
# Contract documents and drafts are archived under object keys
# (contracts/<id>/...). MinIO in compose; AWS S3 by endpoint change.
# S3_BUCKET=contract-documents
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# --- Retrieval -----------------------------------------------------------
# RETRIEVER=keyword (default) | semantic | hybrid  (semantic needs a
# real backend for embeddings; vectors are stored in pgvector)
# RETRIEVER=keyword

# --- API -----------------------------------------------------------------
# API_KEY=            # when set, data endpoints require X-API-Key
# ACTION_WEBHOOK_URL= # opt-in: POST the approved packet here on counsel approval
# ACTION_WEBHOOK_SECRET= # when set, webhook requests are HMAC-signed (X-Trida-Signature: sha256=<hex of body>)
# REVIEWER=on         # independent reviewer stage (off to disable)
# CHECKPOINTS=on      # LangGraph checkpointer for the counsel gate

# --- Counsel queue SLA ----------------------------------------------------
# How long an awaiting contract may wait, in business days, by its worst
# clause position (preferred carries no budget). Breaches sort first in
# the queue and are counted in /metrics.
# QUEUE_SLA_WALK_AWAY_BUSINESS_DAYS=2
# QUEUE_SLA_REVIEW_REQUIRED_BUSINESS_DAYS=5
# QUEUE_SLA_ACCEPTABLE_FALLBACK_BUSINESS_DAYS=10

# --- Certificate renewal watch ---------------------------------------------
# Relied-upon certificates of insurance (their expiry check passed review)
# expiring within this many days are flagged by the deadline sweep with a
# certificate_expiring event, and served by GET /certificates/expiring.
# CERTIFICATE_EXPIRY_WATCH_DAYS=90
