# Copy to .env and fill in. Every value is optional for the offline
# demo; the production topology (docker compose) sets DATABASE_URL and
# S3_* for you.

# --- Model backend -------------------------------------------------------
# mock (default) = deterministic offline fallback, clearly labelled.
# openai | anthropic | ollama = real provider calls.
MODEL_BACKEND=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# Embedding models for RETRIEVER=semantic|hybrid:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# NVIDIA NIM — the endpoints NVIDIA's own blueprints deploy on:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b
# OPENAI_API_KEY=nvapi-...
# (model name verified live against the hosted catalog 2026-10-10;
# hosted catalog names rotate — if a name returns 410/404, pick its
# successor on build.nvidia.com. Or a self-hosted NIM container at
# http://localhost:8000/v1)

# --- System of record: PostgreSQL ---------------------------------------
# Records (decisions store), LangGraph checkpoints, and pgvector
# embeddings all live here. When unset, the app runs with in-memory
# doubles — tests and offline demos only, never a deployment story.
# DATABASE_URL=postgresql://contract:contract@localhost:5432/contracts

# --- Document storage: S3-compatible ------------------------------------
# Contract documents and drafts are archived under object keys
# (contracts/<id>/...). SeaweedFS gateway in compose; AWS S3 by
# endpoint change.
# S3_BUCKET=contract-documents
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# --- Retrieval -----------------------------------------------------------
# RETRIEVER=keyword (default) | semantic | hybrid  (semantic needs a
# real backend for embeddings; vectors are stored in pgvector)
# RETRIEVER=keyword

# NOTE: keep comments on their own lines. The loader reads everything
# after "=" as the value, so "KEY=value  # note" sets "value  # note".

# --- API -----------------------------------------------------------------
# When set, data endpoints require the X-API-Key header. Unset = the API
# is open (local development only).
# API_KEY=
# Opt-in: POST the approved packet here on counsel approval.
# ACTION_WEBHOOK_URL=
# When set, webhook requests are HMAC-signed
# (X-Trida-Signature: sha256=<hex of body>).
# ACTION_WEBHOOK_SECRET=
# ACTION_WEBHOOK_TIMEOUT_SECONDS=5
# Webhook outbox retention: SENT entries older than this (days) may be
# pruned by a named operator (POST /webhooks/outbox/prune); FAILED
# entries are never pruned. A failed entry unrepaired longer than the
# stale threshold (days) is surfaced as stale in /metrics and /queue.
# WEBHOOK_OUTBOX_RETENTION_DAYS=90
# WEBHOOK_OUTBOX_STALE_FAILURE_DAYS=7

# --- Pipeline ------------------------------------------------------------
# Independent reviewer stage (off to disable); REVIEWER_MODEL optionally
# names a separate model for it.
# REVIEWER=on
# REVIEWER_MODEL=
# LangGraph checkpointer for the counsel gate (off to disable).
# CHECKPOINTS=on
# Guardrail repair loop: redraft failing drafts up to N times (0-3).
# GUARDRAIL_REPAIR=on
# GUARDRAIL_REPAIR_MAX_ATTEMPTS=1
# Per-run token budget; past it, provider steps fall back to the
# deterministic templates. 0 / unset = no budget.
# RUN_TOKEN_BUDGET=0
# Provider call timeout, and the per-node timeout around it (seconds).
# LLM_TIMEOUT_SECONDS=60
# NODE_TIMEOUT_SECONDS=180
# Tool calls the assessment loop may make in provider mode.
# ASSESSMENT_MAX_TOOL_CALLS=4

# --- Counsel queue SLA ----------------------------------------------------
# How long an awaiting contract may wait, in business days, by its worst
# clause position (preferred carries no budget). Breaches sort first in
# the queue and are counted in /metrics.
# QUEUE_SLA_WALK_AWAY_BUSINESS_DAYS=2
# QUEUE_SLA_REVIEW_REQUIRED_BUSINESS_DAYS=5
# QUEUE_SLA_ACCEPTABLE_FALLBACK_BUSINESS_DAYS=10

# --- Certificate renewal watch ---------------------------------------------
# Relied-upon certificates of insurance (their expiry check passed review)
# expiring within this many days are flagged by the deadline sweep with a
# certificate_expiring event, and served by GET /certificates/expiring.
# CERTIFICATE_EXPIRY_WATCH_DAYS=90
# A renewal chased this many days ago with the watch still open reads
# stale on the watch row and resurfaces on the counsel queue.
# CERTIFICATE_WATCH_FOLLOW_THROUGH_STALE_DAYS=30

# --- Obligations -----------------------------------------------------------
# Window (days) for announcing due register entries as obligation_due
# events at analysis time.
# OBLIGATION_DUE_WINDOW_DAYS=90
